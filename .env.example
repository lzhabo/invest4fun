# Local demo: deterministic fixtures, never broadcast.
INVESTMADE_DEMO_MODE=true
# Local development only: fetch real Solana quotes and ask the selected Privy wallet to sign the basket.
# Never enable this in production; full production mode remains INVESTMADE_DEMO_MODE=false.
LOCAL_LIVE_EXECUTION=false
# Two-person-style release boundary: preparation and broadcast stay off until
# each stage has been verified in the target environment.
LIVE_PURCHASES_ENABLED=false
LIVE_BROADCAST_ENABLED=false
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
PRIVY_APP_ID=replace-with-privy-app-id
PRIVY_APP_SECRET=replace-with-privy-app-secret


# Required when INVESTMADE_DEMO_MODE=false. Use Neon's pooled URL at runtime.
DATABASE_URL=postgresql://user:password@localhost:5432/investmade_fun
# Use Neon's direct URL only for `npm run db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/investmade_fun
JUPITER_API_KEY=
# Use an Alchemy Solana endpoint; read-only Portfolio derives its Data API key from this URL.
SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/replace-with-alchemy-key
SOLANA_WS_URL=wss://solana-mainnet.g.alchemy.com/v2/replace-with-alchemy-key
# Vercel sends this value as `Authorization: Bearer ...` to cron routes.
CRON_SECRET=replace-with-at-least-32-random-characters
RECONCILIATION_BATCH_SIZE=20
# Optional CoinGecko Demo API key for higher limits. Keep it server-side; never prefix it with VITE_.
COINGECKO_API_KEY=
